# Server Port (optional, defaults to 3000)
PORT=3000

# MusicBrainz Contact: Email for MusicBrainz User-Agent header (recommended by MusicBrainz API terms)
MUSICBRAINZ_CONTACT="contact@example.com"

# Spotify API: (Optional) Client credentials for Spotify Web API enrichment
# Register a free developer app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

