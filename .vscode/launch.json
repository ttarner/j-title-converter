{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dev Server (npm run dev)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev"
    },
    {
      "name": "Debug Server (tsx server.ts)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "server.ts"
      ],
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Production Server (dist/server.cjs)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/dist/server.cjs",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}